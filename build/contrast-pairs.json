  "exemptions": [
    {
      "token": "border.default",
      "reason": "Decorative divider (about 1.3:1 by design); the sole boundary of a control uses border.strong, which has 3:1 pairs"
    },
    {
      "token": "border.subtle",
      "reason": "Decorative separator inside cards; carries no meaning (WCAG 1.4.11 does not apply)"
    },
    {
      "token": "border.card",
      "reason": "Card edge: transparent in light, a quiet edge in dark; the card is separated by surface.raised and its content, so the edge is not the sole boundary"
    },
    {
      "token": "text.disabled",
      "reason": "Disabled elements are exempt from WCAG 1.4.3; kept discernible but with no minimum (architecture section 10)"
    },
