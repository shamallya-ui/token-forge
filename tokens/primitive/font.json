{
  "shamallya": {
    "primitive": {
      "font": {
        "family": {
          "$type": "fontFamily",
          "heading": {
            "$value": [
              "Fraunces",
              "Georgia",
              "serif"
            ]
          },
          "body": {
            "$value": [
              "Inter",
              "system-ui",
              "sans-serif"
            ]
          },
          "mono": {
            "$value": [
              "JetBrains Mono",
              "ui-monospace",
              "monospace"
            ]
          }
        },
        "size": {
          "$type": "dimension",
          "xs": {
            "$value": "0.75rem"
          },
          "sm": {
            "$value": "0.875rem"
          },
          "md": {
            "$value": "1rem"
          },
          "lg": {
            "$value": "1.125rem"
          },
          "xl": {
            "$value": "1.25rem"
          },
          "2xl": {
            "$value": "1.5rem"
          },
          "3xl": {
            "$value": "1.875rem"
          },
          "4xl": {
            "$value": "2.25rem"
          },
          "display": {
            "$value": "3rem",
            "$description": "Large display word, e.g. flashcards"
          },
          "floor": {
            "$value": "0.9375rem",
            "$description": "Smallest text in comfortable mode, 15px"
          },
          "reading": {
            "$value": "1.0625rem",
            "$description": "Explanatory prose in comfortable mode, 17px"
          },
          "body-lg": {
            "$value": "1.1875rem",
            "$description": "Primary names and values in comfortable mode, 19px"
          },
          "title": {
            "$value": "1.75rem",
            "$description": "Pushed-screen title, 28px"
          },
          "numeral": {
            "$value": "3.75rem",
            "$description": "Large display numeral such as a page number, 60px"
          }
        },
        "weight": {
          "$type": "fontWeight",
          "regular": {
            "$value": 400
          },
          "medium": {
            "$value": 500
          },
          "semibold": {
            "$value": 600
          },
          "bold": {
            "$value": 700
          }
        },
        "line-height": {
          "$type": "number",
          "tight": {
            "$value": 1.2
          },
          "normal": {
            "$value": 1.5
          },
          "relaxed": {
            "$value": 1.7
          }
        }
      }
    }
  }
}
