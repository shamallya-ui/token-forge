{
  "shamallya": {
    "semantic": {
      "size": {
        "control-height": {
          "$type": "dimension",
          "$value": "3.5rem"
        },
        "target-min": {
          "$type": "dimension",
          "$value": "3rem",
          "$description": "Minimum size of any interactive target"
        },
        "icon-target": {
          "$type": "dimension",
          "$value": "3rem",
          "$description": "Icon-only button size"
        },
        "text-floor": {
          "$type": "dimension",
          "$value": "{shamallya.primitive.font.size.floor}",
          "$description": "Smallest allowed text size"
        },
        "text-body": {
          "$type": "dimension",
          "$value": "{shamallya.primitive.font.size.body-lg}"
        },
        "text-reading": {
          "$type": "dimension",
          "$value": "{shamallya.primitive.font.size.reading}"
        },
        "title": {
          "$type": "dimension",
          "$value": "{shamallya.primitive.font.size.title}"
        },
        "numeral": {
          "$type": "dimension",
          "$value": "{shamallya.primitive.font.size.numeral}"
        },
        "focus-ring-width": {
          "$type": "dimension",
          "$value": "0.1875rem",
          "$description": "Focus ring thickness, 3px"
        },
        "focus-ring-offset": {
          "$type": "dimension",
          "$value": "0.125rem",
          "$description": "Gap between element and focus ring, 2px"
        }
      }
    }
  }
}
