        "lg": { "$value": "{shamallya.primitive.space.6}" }
      },
      "stack": {
        "sm": { "$value": "{shamallya.primitive.space.2}" },
        "md": { "$value": "{shamallya.primitive.space.4}" },
        "lg": { "$value": "{shamallya.primitive.space.8}" }
      },
      "gap": {
        "sm": { "$value": "{shamallya.primitive.space.2}" },
        "md": { "$value": "{shamallya.primitive.space.4}" }
      },
      "section": { "$value": "{shamallya.primitive.space.12}" },
      "touch-target": { "$value": "2.75rem", "$description": "Minimum touch target, about 44px" }
    },
    "radius": {
